<?xml version="1.0" encoding="utf-8"?>
<!--
  Printers are addressed by LAN IP (e.g. 192.168.1.20), so cleartext cannot be limited to named
  domains. The app only ever opens connections to printers the user picked or typed in.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
